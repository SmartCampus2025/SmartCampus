# SmartCampus Environment Configuration Example
# Copy this file to backend/.env and configure your production secrets.

NODE_ENV=production
PORT=5000

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/smartcampus

# JSON Web Token Secret (Change to a strong random key in production)
JWT_SECRET=production_smartcampus_super_secret_jwt_key_987654321

# Email Dispatch Configuration (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password

# Twilio SMS Service Configuration
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15005550006

# Decision Support Weights (Optional Tuning)
DS_W_ATT=0.45
DS_W_MARKS=0.40
DS_W_FEE=0.15
